# Copia este archivo a .env.local y rellena con los datos de Supabase (Project Settings → API).
# Ambos valores son públicos: la seguridad la dan RLS y las funciones de la base de datos.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para scripts locales (npm run db:contenido). Connection string del "Session pooler". NO es pública.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
